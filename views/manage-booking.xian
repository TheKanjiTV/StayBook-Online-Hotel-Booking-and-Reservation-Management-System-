{{> head}}
<body>{{> nav}}
<main id="main" class="shell manage-page"><div class="manage-layout"><section class="manage-copy"><h1>My StayBook</h1><p>Find your saved booking, check the details, or manage a change of plans.</p>{{#if account}}<a class="text-link" href="/account">Your bookings {{> arrow}}</a>{{else}}<a class="text-link" href="/sign-in">Sign in to view your account bookings {{> arrow}}</a>{{/if}}</section>
  <section class="lookup-panel" aria-labelledby="lookupTitle"><h2 id="lookupTitle">Find your booking</h2><p class="muted mt-3 mb-7">You’ll need your booking reference and the email address used for the reservation.</p>
    <form id="lookup" class="space-y-5"><div><label for="reference">Booking reference</label><input id="reference" name="reference" maxlength="30" placeholder="SB-XXXXXXXXXXXX" autocomplete="off" required></div><div><label for="email">Email address</label><input id="email" name="email" type="email" maxlength="255" autocomplete="email" placeholder="you@example.com" required></div><p id="error" role="alert" tabindex="-1" class="form-error"></p><button class="btn w-full">Find my booking {{> arrow}}</button></form><p class="field-help mt-5">Use the reference and email from your saved booking.</p>
  </section></div></main>{{> footer}}
<script>document.getElementById('lookup').addEventListener('submit', async e => { e.preventDefault(); const button=e.target.querySelector('button'), original=button.innerHTML, error=document.getElementById('error'); error.textContent=''; button.disabled=true; button.textContent='Finding your booking…'; try { const data=await StayBook.request('/api/bookings/lookup',{method:'POST',body:Object.fromEntries(new FormData(e.target))}); location.href=data.redirect; } catch(problem){error.textContent=problem.message; error.focus();} finally{button.disabled=false; button.innerHTML=original;} });</script>
</body></html>
