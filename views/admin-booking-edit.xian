{{> admin-start}}
<a class="back-link" href="/admin/bookings/{{booking.reservation_id}}">Back to booking</a><div class="admin-heading"><h1>Edit booking</h1><p data-no-translate>{{booking.reference}}</p></div>
<form data-admin-form data-endpoint="/api/admin/bookings/{{booking.reservation_id}}/update" class="admin-edit-form"><input name="version" type="hidden" value="{{booking.version}}">
<div class="admin-form-grid"><div><label for="firstName">First name</label><input id="firstName" name="firstName" value="{{booking.first_name}}" maxlength="100" required></div><div><label for="lastName">Last name</label><input id="lastName" name="lastName" value="{{booking.last_name}}" maxlength="100" required></div><div><label for="email">Email address</label><input id="email" name="email" type="email" value="{{booking.email}}" maxlength="255" required></div><div><label for="phone">Phone number</label><input id="phone" name="phone" value="{{booking.phone}}" maxlength="20" required></div><div class="admin-form-wide"><label for="address">Address (optional)</label><textarea id="address" name="address" maxlength="1000">{{booking.address}}</textarea></div><div class="admin-form-wide"><label for="roomId">Room</label><select id="roomId" name="roomId" required>{{#each rooms}}<option value="{{room_id}}" {{#if selected}}selected{{/if}} data-no-translate>{{hotelName}} · {{room_number}} · {{type}}</option>{{/each}}</select></div><div><label for="checkIn">Check-in</label><input id="checkIn" name="checkIn" type="date" value="{{booking.check_in}}" required></div><div><label for="checkOut">Check-out</label><input id="checkOut" name="checkOut" type="date" value="{{booking.check_out}}" required></div><div><label for="guests">Guests</label><input id="guests" name="guests" type="number" min="1" max="10" value="{{booking.guests}}" required></div></div>
<p class="field-help mt-5">Changing the room or dates recalculates the total and returns the booking to awaiting confirmation.</p><p role="alert" tabindex="-1" class="form-error mt-5"></p><div class="admin-form-actions"><button type="submit" class="btn">Save changes</button><a class="back-link" href="/admin/bookings/{{booking.reservation_id}}">Go back</a></div></form>
{{> admin-end}}
