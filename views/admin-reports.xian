{{> admin-start}}<div class="review-heading admin-heading"><div><h1>Reports</h1><p>Reservation totals grouped by check-in date.</p></div><a class="btn" href="{{exportUrl}}">Export CSV {{> arrow}}</a></div><form method="get" action="/admin/reports" class="admin-report-filters"><div><label for="reportFrom">From</label><input id="reportFrom" name="from" type="date" value="{{from}}" required></div><div><label for="reportTo">To</label><input id="reportTo" name="to" type="date" value="{{to}}" min="{{from}}" required></div><div><label for="reportHotel">Hotel or resort</label><select id="reportHotel" name="hotelId"><option value="">All stays</option>{{#each hotels}}<option value="{{id}}" {{#if selected}}selected{{/if}} data-no-translate>{{name}}</option>{{/each}}</select></div><button class="btn">View report</button></form>
<dl class="admin-stats admin-section"><div><dt>Reservations</dt><dd>{{count}}</dd></div><div><dt>Awaiting confirmation</dt><dd>{{pending}}</dd></div><div><dt>Confirmed in StayBook</dt><dd>{{confirmed}}</dd></div><div><dt>Cancelled bookings</dt><dd>{{cancelled}}</dd></div><div><dt>Booked nights</dt><dd>{{nights}}</dd></div><div><dt>Active booking value</dt><dd data-no-translate>{{valueLabel}}</dd></div></dl>
<p class="field-help mt-5">Values are quoted booking totals, not payments collected. Cancelled and deleted bookings are excluded from active value.</p><section class="admin-section"><h2>Bookings by room type</h2><div class="admin-table-scroll mt-5" tabindex="0" role="region" aria-label="Bookings by room type"><table class="admin-table"><thead><tr><th scope="col">Room type</th><th scope="col">Reservations</th><th scope="col">Booked nights</th><th scope="col">Active booking value</th></tr></thead><tbody>{{#each types}}<tr><td>{{room_type}}</td><td>{{count}}</td><td>{{nights}}</td><td data-no-translate>{{valueLabel}}</td></tr>{{else}}<tr><td colspan="4">No active bookings in this period.</td></tr>{{/each}}</tbody></table></div></section>{{> admin-end}}
