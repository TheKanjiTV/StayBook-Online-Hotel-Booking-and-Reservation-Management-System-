{{> head}}
<body class="receipt-page">
<div class="receipt-toolbar no-print"><a class="back-link" href="/confirmation">Back to booking</a><button id="printReceipt" class="btn">Print receipt</button></div>
<main id="main" class="receipt-main"><article class="booking-receipt" aria-label="Booking receipt">
<header class="receipt-heading"><a class="brand" href="/">StayBook</a><h1>Booking receipt</h1><p class="receipt-status"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m7 12 3 3 7-7"/></svg><span>{{#if receipt.cancelled}}Booking cancelled{{else}}Booking saved{{/if}}</span></p></header>
<section class="receipt-payment"><div class="receipt-guest" data-no-translate><strong>{{booking.first_name}} {{booking.last_name}}</strong><p>{{booking.phone}}</p><p>{{booking.email}}</p></div>
<dl class="receipt-facts"><div><dt>Booking reference</dt><dd data-no-translate>{{booking.reference}}</dd></div><div><dt>Payment method</dt><dd><span data-no-translate>{{receipt.method}}</span></dd></div><div><dt>Date</dt><dd data-no-translate>{{receipt.paidAt}}</dd></div><div><dt>Amount</dt><dd data-no-translate>{{receipt.total}}</dd></div></dl>
<div class="receipt-total"><span>Total</span><strong data-no-translate>{{receipt.total}}</strong></div>
<p class="receipt-transaction"><span>Booking record reference</span><br><span data-no-translate>{{receipt.reference}}</span></p>
{{#if receipt.estimate}}<p class="receipt-estimate"><span>Display estimate</span>: <span data-no-translate>{{receipt.estimate}}</span></p>{{/if}}</section>
<section class="receipt-stay">{{#if booking.room.image}}<img class="receipt-photo" src="{{booking.room.image}}" alt="Illustrative room photograph" width="500" height="260">{{/if}}<div class="receipt-room"><h2>{{booking.room_type}}</h2><p class="muted"><span>Room {{booking.room_number}}</span> · <span data-no-translate>{{booking.hotel.name}}</span></p><dl class="receipt-dates"><div><dt>Check-in</dt><dd data-no-translate>{{receipt.checkIn}}</dd></div><div><dt>Check-out</dt><dd data-no-translate>{{receipt.checkOut}}</dd></div></dl><p class="receipt-occupancy">{{booking.nights}} {{receipt.nightsLabel}} · {{booking.guests}} {{receipt.guestsLabel}}</p><div class="receipt-rate"><span><span data-no-translate>{{receipt.nightlyRate}}</span> × <span>{{booking.nights}} {{receipt.nightsLabel}}</span></span><span data-no-translate>{{receipt.total}}</span></div><div class="receipt-total receipt-stay-total"><span>Total for your stay</span><strong data-no-translate>{{receipt.total}}</strong></div></div></section>
<footer class="receipt-footnote"><p>No payment has been collected.</p><p>Hotel confirmation is pending.</p></footer>
</article></main><script src="/receipt.js"></script></body></html>
