{{> admin-start}}
<div class="admin-heading"><h1>Audit logs</h1><p>Review changes to bookings, rooms and accounts.</p></div>

<form method="get" action="/admin/audit-logs" class="admin-search" role="search">
  <label for="auditSearch">Search activity</label>
  <div><input id="auditSearch" name="q" value="{{q}}" maxlength="100" placeholder="Action, name or reference"><button class="btn">Search</button></div>
</form>
<p class="admin-results"><span>Records</span>: {{count}}</p>

{{#if audits.length}}
<div class="admin-table-scroll audit-table-wrap" role="region" tabindex="0" aria-label="Audit logs">
  <table class="admin-table audit-table">
    <thead><tr>
      <th scope="col">Created date</th><th scope="col">Performed by</th><th scope="col">Role</th><th scope="col">Record</th>
      <th scope="col">Event</th><th scope="col">Source</th><th scope="col">What changed</th>
      <th scope="col" class="audit-view"><span class="sr-only">Details</span></th>
    </tr></thead>
    <tbody>
    {{#each audits}}
    <tr>
      <td data-no-translate>{{timestamp}}</td><td data-no-translate>{{actor_name}}</td>
      <td><span class="audit-role">{{role}}</span></td><td data-no-translate>{{reference}}</td>
      <td>{{> audit-event}}</td><td>{{source}}</td><td>{{actionLabel}}</td>
      <td class="audit-view"><a class="booking-icon-button audit-eye" data-booking-panel-link href="/admin/audit-logs/{{id}}" aria-label="View audit event" title="View audit event"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 12s3.5-5 9-5 9 5 9 5-3.5 5-9 5-9-5-9-5Z"/><circle cx="12" cy="12" r="2.25"/></svg></a></td>
    </tr>
    {{/each}}
    </tbody>
  </table>
</div>
{{else}}
<p class="admin-empty">No admin activity found.</p>
{{/if}}

<nav class="admin-pagination" aria-label="Audit log pages">
  {{#if previous}}<a class="btn-secondary" href="{{previous}}">Previous</a>{{/if}}
  <p><span>Page</span> {{page}} / {{pages}}</p>
  {{#if next}}<a class="btn-secondary" href="{{next}}">Next</a>{{/if}}
</nav>
{{> admin-end}}
