{{> admin-start}}
<a class="back-link" href="/admin/bookings">Back to bookings</a>
<div class="admin-heading"><h1>Booking details</h1><p data-no-translate>{{booking.reference}}</p></div>
<div class="admin-detail-grid"><section aria-labelledby="adminGuestTitle"><h2 id="adminGuestTitle">Guest details</h2><dl class="review-details"><div class="review-row"><dt>Guest</dt><dd data-no-translate>{{booking.first_name}} {{booking.last_name}}</dd></div><div class="review-row"><dt>Email address</dt><dd data-no-translate>{{booking.email}}</dd></div><div class="review-row"><dt>Phone number</dt><dd data-no-translate>{{booking.phone}}</dd></div>{{#if booking.address}}<div class="review-row"><dt>Address</dt><dd data-no-translate>{{booking.address}}</dd></div>{{/if}}</dl></section>
<section aria-labelledby="adminStayTitle"><h2 id="adminStayTitle">Your stay</h2><dl class="review-details"><div class="review-row"><dt>Room</dt><dd>{{booking.room_type}} · <span data-no-translate>{{booking.room_number}}</span></dd></div><div class="review-row"><dt>Hotel or resort</dt><dd data-no-translate>{{booking.hotelName}}</dd></div><div class="review-row"><dt>Check-in</dt><dd data-no-translate>{{booking.checkIn}}</dd></div><div class="review-row"><dt>Check-out</dt><dd data-no-translate>{{booking.checkOut}}</dd></div><div class="review-row"><dt>Guests</dt><dd>{{booking.guests}}</dd></div><div class="review-row"><dt>Total (PHP)</dt><dd data-no-translate>{{booking.total}}</dd></div><div class="review-row"><dt>Payment preference</dt><dd>{{paymentMethod}}</dd></div><div class="review-row"><dt>Booking status</dt><dd>{{booking.statusLabel}}</dd></div></dl></section></div>
<p class="admin-payment-note">{{#if booking.cancelled}}Your booking has been cancelled. No payment was collected.{{else}}No payment has been collected. Hotel confirmation is pending.{{/if}}</p>
<div class="admin-form-actions">{{#unless booking.cancelled}}{{#unless booking.confirmed}}<button class="btn" data-admin-action data-url="/api/admin/bookings/{{booking.reservation_id}}/confirm" data-title="Confirm this booking?" data-description="This approves the reservation in StayBook. Hotel confirmation is still pending." data-label="Confirm booking" data-reference="{{booking.reference}}">Confirm booking</button>{{/unless}}{{#if isAdmin}}<a class="btn-secondary" href="/admin/bookings/{{booking.reservation_id}}/edit">Edit booking</a><button id="adminCancel" class="cancel-link" data-admin-action data-url="/api/admin/bookings/{{booking.reservation_id}}/cancel" data-title="Cancel this booking?" data-description="No payment has been collected." data-label="Cancel booking" data-danger="true" data-reference="{{booking.reference}}">Cancel booking</button>{{/if}}{{/unless}}{{#if isAdmin}}{{#unless booking.deletion_requested_by}}<button class="cancel-link" data-admin-action data-url="/api/admin/bookings/{{booking.reservation_id}}/delete" data-title="Delete this booking?" data-description="The booking will be removed from active records. Audit history will remain." data-label="Delete booking" data-danger="true" data-reference="{{booking.reference}}">Delete booking</button>{{/unless}}{{/if}}
{{#if isBookingStaff}}{{#unless booking.deletion_requested_by}}<button class="cancel-link" type="button" data-admin-action data-url="/api/admin/bookings/{{booking.reservation_id}}/request-deletion" data-title="Request booking deletion?" data-description="An administrator will review this request. The booking stays active until approved." data-label="Request deletion" data-reference="{{booking.reference}}">Request deletion</button>{{/unless}}{{/if}}</div>
{{#if booking.deletion_requested_by}}
<section class="admin-section" aria-labelledby="deletionRequestTitle">
  <h2 id="deletionRequestTitle">Deletion requested</h2>
  {{#if isAdmin}}
  <p class="muted mt-3 mb-4">Review the booking above. Enter your administrator password to approve deletion, or dismiss the request to keep the booking.</p>
  <form data-admin-form class="admin-edit-form" data-endpoint="/api/admin/bookings/{{booking.reservation_id}}/approve-deletion">
    <input name="version" type="hidden" value="{{booking.version}}">
    <label for="deletionPassword">Administrator password</label>
    <div class="password-field"><input id="deletionPassword" name="password" type="password" autocomplete="current-password" maxlength="128" required></div>
    <p class="form-error mt-3" role="alert" tabindex="-1"></p>
    <div class="admin-form-actions"><button class="btn-danger" type="submit">Approve deletion</button></div>
  </form>
  <form data-admin-form class="admin-form-actions" data-endpoint="/api/admin/bookings/{{booking.reservation_id}}/dismiss-deletion">
    <input name="version" type="hidden" value="{{booking.version}}">
    <button class="btn-secondary" type="submit">Dismiss request</button>
    <p class="form-error" role="alert" tabindex="-1"></p>
  </form>
  {{else}}
  <p class="muted mt-3">Waiting for an administrator to review the request.</p>
  {{/if}}
</section>
{{/if}}
{{> admin-end}}
