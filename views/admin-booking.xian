{{> admin-start}}
<a class="back-link" href="/admin/bookings">Back to bookings</a>
<div class="admin-heading"><h1>Booking details</h1><p data-no-translate>{{booking.reference}}</p></div>
<div class="admin-detail-grid"><section aria-labelledby="adminGuestTitle"><h2 id="adminGuestTitle">Guest details</h2><dl class="review-details"><div class="review-row"><dt>Guest</dt><dd data-no-translate>{{booking.first_name}} {{booking.last_name}}</dd></div><div class="review-row"><dt>Email address</dt><dd data-no-translate>{{booking.email}}</dd></div><div class="review-row"><dt>Phone number</dt><dd data-no-translate>{{booking.phone}}</dd></div>{{#if booking.address}}<div class="review-row"><dt>Address</dt><dd data-no-translate>{{booking.address}}</dd></div>{{/if}}</dl></section>
<section aria-labelledby="adminStayTitle"><h2 id="adminStayTitle">Your stay</h2><dl class="review-details"><div class="review-row"><dt>Room</dt><dd>{{booking.room_type}} · <span data-no-translate>{{booking.room_number}}</span></dd></div><div class="review-row"><dt>Hotel or resort</dt><dd data-no-translate>{{booking.hotelName}}</dd></div><div class="review-row"><dt>Check-in</dt><dd data-no-translate>{{booking.checkIn}}</dd></div><div class="review-row"><dt>Check-out</dt><dd data-no-translate>{{booking.checkOut}}</dd></div><div class="review-row"><dt>Guests</dt><dd>{{booking.guests}}</dd></div><div class="review-row"><dt>Total (PHP)</dt><dd data-no-translate>{{booking.total}}</dd></div><div class="review-row"><dt>Payment preference</dt><dd>{{paymentMethod}}</dd></div><div class="review-row"><dt>Booking status</dt><dd>{{booking.statusLabel}}</dd></div></dl></section></div>
<p class="admin-payment-note">{{#if booking.cancelled}}Your booking has been cancelled. No payment was collected.{{else}}No payment has been collected. Hotel confirmation is pending.{{/if}}</p>
<div class="admin-form-actions">{{#unless booking.cancelled}}{{#unless booking.confirmed}}<button class="btn" data-admin-action data-url="/api/admin/bookings/{{booking.reservation_id}}/confirm" data-title="Confirm this booking?" data-description="This approves the reservation in StayBook. Hotel confirmation is still pending." data-label="Confirm booking" data-reference="{{booking.reference}}">Confirm booking</button>{{/unless}}<a class="btn-secondary" href="/admin/bookings/{{booking.reservation_id}}/edit">Edit booking</a><button id="adminCancel" class="cancel-link" data-admin-action data-url="/api/admin/bookings/{{booking.reservation_id}}/cancel" data-title="Cancel this booking?" data-description="No payment has been collected." data-label="Cancel booking" data-danger="true" data-reference="{{booking.reference}}">Cancel booking</button>{{/unless}}<button class="cancel-link" data-admin-action data-url="/api/admin/bookings/{{booking.reservation_id}}/delete" data-title="Delete this booking?" data-description="The booking will be removed from active records. Audit history will remain." data-label="Delete booking" data-danger="true" data-reference="{{booking.reference}}">Delete booking</button></div>
{{> admin-end}}
