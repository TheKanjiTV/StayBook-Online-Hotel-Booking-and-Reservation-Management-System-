{{> head}}
<body>{{> nav}}
<main id="main" class="shell admin-page">
<a class="back-link" href="/admin">Back to bookings</a>
<div class="admin-heading"><h1>Booking details</h1><p data-no-translate>{{booking.reference}}</p></div>
<div class="admin-detail-grid"><section aria-labelledby="adminGuestTitle"><h2 id="adminGuestTitle">Guest details</h2><dl class="review-details"><div class="review-row"><dt>Guest</dt><dd data-no-translate>{{booking.first_name}} {{booking.last_name}}</dd></div><div class="review-row"><dt>Email address</dt><dd data-no-translate>{{booking.email}}</dd></div><div class="review-row"><dt>Phone number</dt><dd data-no-translate>{{booking.phone}}</dd></div>{{#if booking.address}}<div class="review-row"><dt>Address</dt><dd data-no-translate>{{booking.address}}</dd></div>{{/if}}</dl></section>
<section aria-labelledby="adminStayTitle"><h2 id="adminStayTitle">Your stay</h2><dl class="review-details"><div class="review-row"><dt>Room</dt><dd>{{booking.room_type}} · <span data-no-translate>{{booking.room_number}}</span></dd></div><div class="review-row"><dt>Hotel or resort</dt><dd data-no-translate>{{booking.hotelName}}</dd></div><div class="review-row"><dt>Check-in</dt><dd data-no-translate>{{booking.checkIn}}</dd></div><div class="review-row"><dt>Check-out</dt><dd data-no-translate>{{booking.checkOut}}</dd></div><div class="review-row"><dt>Guests</dt><dd>{{booking.guests}}</dd></div><div class="review-row"><dt>Total (PHP)</dt><dd data-no-translate>{{booking.total}}</dd></div><div class="review-row"><dt>Payment preference</dt><dd>{{paymentMethod}}</dd></div><div class="review-row"><dt>Booking status</dt><dd>{{#if booking.cancelled}}Cancelled{{else}}Awaiting confirmation{{/if}}</dd></div></dl></section></div>
<p class="admin-payment-note">{{#if booking.cancelled}}Your booking has been cancelled. No payment was collected.{{else}}No payment has been collected. Hotel confirmation is pending.{{/if}}</p>
{{#unless booking.cancelled}}<button id="adminCancel" class="cancel-link" type="button" data-reservation="{{booking.reservation_id}}">Cancel booking</button>{{/unless}}
</main>
<dialog id="adminCancelDialog" class="booking-dialog no-print" aria-labelledby="adminCancelTitle" aria-describedby="adminCancelDescription"><h2 id="adminCancelTitle">Cancel this booking?</h2><p id="adminCancelDescription" data-no-translate>{{booking.reference}}</p><p id="adminCancelError" class="form-error" role="alert" tabindex="-1"></p><form method="dialog" class="dialog-actions"><button class="btn-secondary" autofocus>Keep booking</button><button id="adminConfirmCancel" type="button" class="btn btn-danger">Cancel booking</button></form></dialog>
{{> footer}}<script src="/admin-booking.js"></script></body></html>
