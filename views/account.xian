{{> head}}
<body>{{> nav}}<main id="main" class="shell section-space"><div class="section-heading"><div><h1>My StayBook</h1><p class="mt-4">Welcome, {{account.firstName}}. Your next stay starts here.</p></div><button id="signOut" class="btn-secondary">Sign out</button></div>
<section aria-labelledby="bookingsTitle"><div class="review-heading"><h2 id="bookingsTitle">Your bookings</h2><a class="text-link" href="/#booking">Book a stay {{> arrow}}</a></div><p class="muted mb-5">Bookings made while signed in appear here. For a guest booking, use <a class="underline" href="/manage-booking">Find reservations</a>.</p><div id="accountBookings" aria-live="polite"><p>Loading your bookings…</p></div><p id="accountError" role="alert" class="form-error mt-5"></p></section>
</main>{{> footer}}<script src="/account.js"></script></body></html>
