{{> admin-start}}
<a class="back-link" href="/admin/bookings">Back to bookings</a><div class="admin-heading"><h1>Add booking</h1><p>A booking reference is generated automatically when you save.</p></div>
<form data-admin-form data-endpoint="/api/admin/bookings" class="admin-edit-form" id="adminNewBooking"><input name="requestKey" type="hidden" value="{{requestKey}}">
<div class="admin-form-grid"><div><label for="checkIn">Check-in</label><input id="checkIn" name="checkIn" type="date" value="{{checkIn}}" min="{{today}}" required></div><div><label for="checkOut">Check-out</label><input id="checkOut" name="checkOut" type="date" value="{{checkOut}}" min="{{today}}" required></div><div><label for="hotelId">Hotel or resort</label><select id="hotelId"><option value="">All stays</option>{{#each hotels}}<option value="{{id}}" data-no-translate>{{name}}</option>{{/each}}</select></div><div><label for="guests">Guests</label><input id="guests" name="guests" type="number" min="1" max="10" value="2" required></div><div class="admin-form-wide"><label for="roomId">Available rooms</label><select id="roomId" name="roomId" required><option value="">Select a room</option>{{#each rooms}}<option value="{{room_id}}" {{#if selected}}selected{{/if}} data-no-translate>{{hotelName}} · {{room_number}} · {{type}}</option>{{/each}}</select><p id="availabilityMessage" class="field-help" role="status"></p></div>
<div class="admin-form-wide"><label for="accountId">Link to a guest account (optional)</label><select id="accountId" name="accountId"><option value="">Guest booking without an account</option>{{#each accounts}}<option value="{{account_id}}" data-first="{{first_name}}" data-last="{{last_name}}" data-email="{{email}}" data-no-translate>{{first_name}} {{last_name}} · {{email}}</option>{{/each}}</select></div>
<div><label for="firstName">First name</label><input id="firstName" name="firstName" maxlength="100" required></div><div><label for="lastName">Last name</label><input id="lastName" name="lastName" maxlength="100" required></div><div><label for="email">Email address</label><input id="email" name="email" type="email" maxlength="255" required></div><div><label for="phone">Phone number</label><input id="phone" name="phone" maxlength="20" required></div><div class="admin-form-wide"><label for="address">Address (optional)</label><textarea id="address" name="address" maxlength="1000"></textarea></div><div><label for="paymentMethod">Payment preference</label><select id="paymentMethod" name="paymentMethod" required>{{#each methods}}<option value="{{id}}" data-no-translate>{{label}}</option>{{/each}}</select></div></div>
<dl class="admin-quote"><div><dt>Nightly rate</dt><dd id="quotedRate" data-no-translate>—</dd></div><div><dt>Total (PHP)</dt><dd id="quotedTotal" data-no-translate>—</dd></div></dl><p class="field-help">No payment has been collected.</p><p role="alert" tabindex="-1" class="form-error mt-5"></p><div class="admin-form-actions"><button type="submit" class="btn" disabled>Save booking</button><a class="back-link" href="/admin/bookings">Go back</a></div></form>
<script src="/admin-new-booking.js"></script>{{> admin-end}}
