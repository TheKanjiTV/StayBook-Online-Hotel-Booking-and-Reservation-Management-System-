{{> admin-start}}<div class="admin-heading"><h1>Guests</h1><p>Booking history grouped by guest email. Manage sign-in access in Users.</p></div><form class="admin-search" action="/admin/guests" method="get"><label for="guestSearch">Search by guest email</label><div><input id="guestSearch" name="q" value="{{q}}" maxlength="100"><button class="btn">Search</button></div></form><p class="admin-results"><span>Guests</span>: {{count}}</p>
<div class="admin-table-scroll" tabindex="0" role="region" aria-label="Guests"><table class="admin-table"><thead><tr><th scope="col">Guest</th><th scope="col">Email address</th><th scope="col">Reservations</th><th scope="col">Active booking value</th><th scope="col"><span class="sr-only">Actions</span></th></tr></thead><tbody>{{#each guests}}<tr><td data-no-translate>{{firstName}} {{lastName}}<small>{{phone}}</small></td><td data-no-translate>{{email}}</td><td>{{bookingCount}}</td><td data-no-translate>{{value}}</td><td><a class="back-link" href="{{historyUrl}}">View guest history</a></td></tr>{{else}}<tr><td colspan="5">No guests found.</td></tr>{{/each}}</tbody></table></div><nav class="admin-pagination" aria-label="Booking pages">{{#if previous}}<a class="btn-secondary" href="{{previous}}">Previous</a>{{/if}}<p><span>Page</span> {{page}} / {{pages}}</p>{{#if next}}<a class="btn-secondary" href="{{next}}">Next</a>{{/if}}</nav>{{> admin-end}}
