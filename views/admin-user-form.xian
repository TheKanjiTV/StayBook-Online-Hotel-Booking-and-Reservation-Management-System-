{{> admin-start}}
<a class="back-link" href="/admin/users">Back to users</a><div class="admin-heading"><h1>{{#if editing}}Edit account{{else}}Add user{{/if}}</h1><p>{{#if editing}}Update account details, password or role.{{else}}Create an account with the access it needs.{{/if}}</p></div>
<form data-admin-form class="admin-edit-form" data-endpoint="{{#if editing}}/api/admin/users/{{user.account_id}}{{else}}/api/admin/users{{/if}}">{{#if editing}}<input name="version" type="hidden" value="{{user.version}}">{{/if}}
<div class="admin-form-grid"><div><label for="firstName">First name</label><input id="firstName" name="firstName" value="{{user.first_name}}" maxlength="100" required></div><div><label for="lastName">Last name</label><input id="lastName" name="lastName" value="{{user.last_name}}" maxlength="100" required></div><div><label for="email">Email address</label><input id="email" name="email" type="email" value="{{user.email}}" maxlength="255" autocomplete="off" required></div><div><label for="username">Username (optional)</label><input id="username" name="username" value="{{user.username}}" maxlength="100" autocomplete="off" autocapitalize="none" spellcheck="false"></div><div><label for="role">Role</label><select id="role" name="role"><option value="GUEST">Guest</option><option value="ADMIN" {{#if administrator}}selected{{/if}}>Administrator</option></select><p class="field-help">Administrators can manage bookings and accounts.</p></div><div><label for="password">{{#if editing}}New password (optional){{else}}Password{{/if}}</label><div class="password-field"><input id="password" name="password" type="password" minlength="10" maxlength="128" autocomplete="new-password" {{#unless editing}}required{{/unless}}>{{> password-toggle}}</div><p class="field-help">{{#if editing}}Leave blank to keep the current password.{{else}}Use a password with 10–128 characters.{{/if}}</p></div></div>
<p role="alert" tabindex="-1" class="form-error mt-5"></p><div class="admin-form-actions"><button type="submit" class="btn">{{#if editing}}Save changes{{else}}Create account{{/if}}</button><a class="back-link" href="/admin/users">Go back</a></div></form>
{{#if editing}}{{#unless ownAccount}}<section class="admin-section"><h2>Delete account</h2><p class="muted mt-3 mb-4">Account access will be removed. Existing reservations and audit history will remain.</p><button class="cancel-link" data-admin-action data-url="/api/admin/users/{{user.account_id}}/delete" data-title="Delete this account?" data-description="Account access will be removed. Existing reservations and audit history will remain." data-label="Delete account" data-danger="true" data-reference="{{user.email}}">Delete account</button></section>{{/unless}}{{/if}}
{{> admin-end}}
