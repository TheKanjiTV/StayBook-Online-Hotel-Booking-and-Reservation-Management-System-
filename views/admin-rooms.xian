{{> admin-start}}
<div class="admin-heading"><h1>Rooms &amp; rates</h1><p>Manage the room catalog shown in online booking.</p></div><form class="admin-filters" method="get" action="/admin/rooms"><div><label for="roomSearch">Search rooms</label><input id="roomSearch" name="q" value="{{q}}" maxlength="100" placeholder="Room number or room type"></div><div><label for="roomHotel">Hotel or resort</label><select id="roomHotel" name="hotelId"><option value="">All stays</option>{{#each hotels}}<option value="{{id}}" {{#if selected}}selected{{/if}} data-no-translate>{{name}}</option>{{/each}}</select></div><button class="btn">Search</button><a class="back-link" href="/admin/rooms">Clear filters</a></form>
<div class="admin-table-scroll admin-section" role="region" aria-label="Rooms & rates" tabindex="0"><table class="admin-table"><thead><tr><th scope="col">Room</th><th scope="col">Hotel or resort</th><th scope="col">Capacity</th><th scope="col">Nightly rate</th><th scope="col">Publication</th><th scope="col"><span class="sr-only">Actions</span></th></tr></thead><tbody>{{#each rooms}}<tr><td>{{type}}<small data-no-translate>{{room_number}}</small></td><td data-no-translate>{{hotelName}}</td><td>{{capacity}}</td><td data-no-translate>{{priceLabel}}</td><td>{{#if is_published}}Published{{else}}Hidden from booking{{/if}}</td><td><a class="back-link" href="/admin/rooms/{{room_id}}/edit">Edit room</a></td></tr>{{else}}<tr><td colspan="6">No rooms found.</td></tr>{{/each}}</tbody></table></div>{{> admin-end}}
