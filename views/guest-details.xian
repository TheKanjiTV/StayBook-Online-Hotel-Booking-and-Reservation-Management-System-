{{> head}}
<body>{{> nav}}
<main id="main" class="shell checkout-page">
  <ol class="booking-steps" aria-label="Booking progress"><li><a href="/rooms?{{searchQuery}}"><span>1</span> Choose your room</a></li><li aria-current="step"><span>2</span> Guest details</li><li><span>3</span> Review booking</li></ol>
  <div class="checkout-grid">
    <section><div class="page-intro"><h1>Make it your stay.</h1><p>A few details, and you’re one step closer. Please enter the details of the guest making the booking.</p></div>
      <form id="guestForm" class="guest-form">
        <div class="form-section-title"><h2>Your details</h2><p>All fields are required unless marked optional.</p></div>
        <div class="form-two-col"><div><label for="firstName">First name</label><input id="firstName" name="firstName" autocomplete="given-name" value="{{guest.firstName}}" required maxlength="100" placeholder="First name"></div><div><label for="lastName">Last name</label><input id="lastName" name="lastName" autocomplete="family-name" value="{{guest.lastName}}" required maxlength="100" placeholder="Last name"></div></div>
        <div><label for="email">Email address</label><input type="email" id="email" name="email" autocomplete="email" value="{{guest.email}}" required maxlength="255" placeholder="you@example.com"><p class="field-help">Use this email to find your booking later.</p></div>
        <div><label for="phone">Phone number</label><input type="tel" id="phone" name="phone" autocomplete="tel" value="{{guest.phone}}" required minlength="7" maxlength="20" placeholder="e.g. 0912 345 6789"></div>
        <div><label for="address">Address <span class="label-optional">(optional)</span></label><textarea id="address" name="address" rows="2" maxlength="1000" autocomplete="street-address" placeholder="Your address">{{guest.address}}</textarea></div>
        <p id="errorMessage" class="form-error" role="alert" tabindex="-1"></p>
        <div class="form-actions"><a href="/rooms?{{searchQuery}}" class="back-link">Back to rooms</a><button type="submit" class="btn" id="submitButton">Continue to review {{> arrow}}</button></div>
        <p class="field-help">No payment is made on this step. You’ll review everything before saving your booking.</p>
      </form>
    </section>
    <aside class="stay-summary" aria-label="Your stay summary"><details class="summary-disclosure" open><summary class="summary-toggle"><span>Your stay</span><strong>{{stay.total}}</strong><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary><div class="summary-body"><img src="{{room.image}}" alt="{{room.type}} interior, illustrative photograph" width="500" height="310"><div class="summary-content"><h2>{{room.type}}</h2><p class="muted mt-2">Room {{room.roomNumber}} · Up to {{room.capacity}} guests</p><dl class="summary-dates"><div><dt>Check-in</dt><dd>{{stay.checkInLabel}}</dd></div><div><dt>Check-out</dt><dd>{{stay.checkOutLabel}}</dd></div></dl><p class="muted summary-occupancy">{{stay.nights}} {{stay.nightsLabel}} · {{stay.guests}} {{stay.guestsLabel}}</p><div class="summary-rate"><span>{{stay.nightlyRate}} × {{stay.nights}} {{stay.nightsLabel}}</span><span>{{stay.total}}</span></div><div class="summary-total"><span>Total for your stay</span><strong>{{stay.total}}</strong></div><p class="field-help">Sample room catalog. Payment at the next step is simulated.</p></div></div></details></aside>
  </div>
</main>{{> footer}}<script src="/guest-details.js"></script></body></html>
