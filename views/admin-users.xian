{{> admin-start}}
<div class="review-heading admin-heading"><div><h1>Users</h1><p>Manage account access and roles.</p></div><a class="btn" href="/admin/users/new">Add user {{> arrow}}</a></div>
<form action="/admin/users" method="get" class="admin-filters" role="search"><div><label for="userSearch">Search users</label><input id="userSearch" name="q" value="{{q}}" maxlength="100" placeholder="Name, email or username"></div><div><label for="userRole">Role</label><select id="userRole" name="role"><option value="">All roles</option><option value="GUEST" {{#if guestSelected}}selected{{/if}}>Guest</option><option value="ADMIN" {{#if adminSelected}}selected{{/if}}>Administrator</option></select></div><button class="btn">Search</button><a class="back-link" href="/admin/users">Clear filters</a></form>
<p class="admin-results"><span>User accounts</span>: {{count}}</p>
{{#if users.length}}<div class="admin-table-scroll" tabindex="0" role="region" aria-label="User accounts"><table class="admin-table"><thead><tr><th scope="col">Name</th><th scope="col">Email address</th><th scope="col">Username</th><th scope="col">Role</th><th scope="col"><span class="sr-only">Actions</span></th></tr></thead><tbody>{{#each users}}<tr><td data-no-translate>{{first_name}} {{last_name}}</td><td data-no-translate>{{email}}</td><td data-no-translate>{{#if username}}{{username}}{{else}}—{{/if}}</td><td>{{#if administrator}}Administrator{{else}}Guest{{/if}}</td><td><a class="back-link" href="/admin/users/{{account_id}}/edit">Edit account<span class="sr-only" data-no-translate> {{email}}</span></a></td></tr>{{/each}}</tbody></table></div>{{else}}<p class="admin-empty">No accounts found.</p>{{/if}}
<nav class="admin-pagination" aria-label="Booking pages">{{#if previous}}<a class="btn-secondary" href="{{previous}}">Previous</a>{{/if}}<p><span>Page</span> {{page}} / {{pages}}</p>{{#if next}}<a class="btn-secondary" href="{{next}}">Next</a>{{/if}}</nav>
{{> admin-end}}
