{{> admin-start}}<a class="back-link" href="/admin/guests">Back to guests</a><div class="review-heading admin-heading"><div><h1>Guest history</h1><p data-no-translate>{{profile.first_name}} {{profile.last_name}} · {{profile.email}}</p><p data-no-translate>{{profile.phone}}</p></div><a class="btn" href="{{newBookingUrl}}">Add booking {{> arrow}}</a></div><p class="admin-results"><span>Reservations</span>: {{count}}</p><div class="admin-table-scroll" tabindex="0" role="region" aria-label="Reservations"><table class="admin-table"><thead><tr><th scope="col">Booking reference</th><th scope="col">Room</th><th scope="col">Dates</th><th scope="col">Booking status</th><th scope="col">Total (PHP)</th><th scope="col"><span class="sr-only">Actions</span></th></tr></thead><tbody>{{#each bookings}}<tr><td data-no-translate>{{reference}}</td><td>{{room_type}}<small data-no-translate>{{hotelName}}</small></td><td data-no-translate>{{check_in}} – {{check_out}}</td><td>{{statusLabel}}</td><td data-no-translate>{{total}}</td><td><a class="back-link" href="/admin/bookings/{{reservation_id}}">View booking</a></td></tr>{{/each}}</tbody></table></div><nav class="admin-pagination" aria-label="Booking pages">{{#if previous}}<a class="btn-secondary" href="{{previous}}">Previous</a>{{/if}}<p><span>Page</span> {{page}} / {{pages}}</p>{{#if next}}<a class="btn-secondary" href="{{next}}">Next</a>{{/if}}</nav>{{> admin-end}}
