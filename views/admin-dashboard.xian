{{> admin-start}}
<div class="admin-heading"><h1>Dashboard</h1><p>StayBook reservations and recent admin activity.</p></div>
<dl class="admin-stats"><div><dt>Confirmed in StayBook</dt><dd>{{confirmed}}</dd></div><div><dt>Awaiting confirmation</dt><dd>{{pending}}</dd></div><div><dt>Cancelled bookings</dt><dd>{{cancelled}}</dd></div><div><dt>User accounts</dt><dd>{{users}}</dd></div></dl>
<section class="admin-section"><div class="review-heading"><h2>Recent bookings</h2><a class="back-link" href="/admin/bookings">View all bookings</a></div>{{#if bookings.length}}<div class="admin-table-scroll" tabindex="0" role="region" aria-label="Recent bookings"><table class="admin-table"><thead><tr><th>Booking reference</th><th>Guest</th><th>Dates</th><th>Total (PHP)</th><th></th></tr></thead><tbody>{{#each bookings}}<tr><td data-no-translate>{{reference}}</td><td data-no-translate>{{first_name}} {{last_name}}</td><td data-no-translate>{{checkIn}} – {{checkOut}}</td><td data-no-translate>{{total}}</td><td><a class="back-link" href="/admin/bookings/{{reservation_id}}">View booking</a></td></tr>{{/each}}</tbody></table></div>{{else}}<p class="muted">No bookings found</p>{{/if}}</section>
<section class="admin-section"><div class="review-heading"><h2>Recent activity</h2><a class="back-link" href="/admin/audit-logs">View audit logs</a></div>{{#each audits}}<div class="admin-activity"><div><strong>{{actionLabel}}</strong><p data-no-translate>{{actor_name}} · {{reference}}</p></div><time data-no-translate>{{timestamp}}</time></div>{{else}}<p class="muted">No admin activity yet.</p>{{/each}}</section>
{{> admin-end}}
