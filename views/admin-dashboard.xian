{{> admin-start}}
<div class="review-heading admin-heading"><div><h1>Dashboard</h1><p>Review reservations and booking availability.</p></div>{{#if isAdmin}}<a class="btn" href="/admin/bookings/new">Add booking {{> arrow}}</a>{{else}}<a class="btn" href="/admin/bookings?status=LOCAL_CONFIRMED">Review pending bookings {{> arrow}}</a>{{/if}}</div>
<dl class="admin-stats"><div><dt>Confirmed in StayBook</dt><dd>{{confirmed}}</dd></div><div><dt>Awaiting confirmation</dt><dd>{{pending}}</dd></div><div><dt>Cancelled bookings</dt><dd>{{cancelled}}</dd></div><div><dt><a class="back-link" href="/admin/bookings?deletion=1">Deletion requests</a></dt><dd>{{deletionRequests}}</dd></div></dl>
<section class="admin-section"><div class="review-heading"><h2>Recent bookings</h2><a class="back-link" href="/admin/bookings">View all bookings</a></div>{{#if bookings.length}}<div class="admin-table-scroll" tabindex="0" role="region" aria-label="Recent bookings"><table class="admin-table"><thead><tr><th>Booking reference</th><th>Guest</th><th>Dates</th><th>Total (PHP)</th><th></th></tr></thead><tbody>{{#each bookings}}<tr><td data-no-translate>{{reference}}</td><td data-no-translate>{{first_name}} {{last_name}}</td><td data-no-translate>{{checkIn}} – {{checkOut}}</td><td data-no-translate>{{total}}</td><td><a class="back-link" href="/admin/bookings/{{reservation_id}}">View booking</a></td></tr>{{/each}}</tbody></table></div>{{else}}<p class="muted">No bookings found</p>{{/if}}</section>
{{#if isAdmin}}<section class="admin-section"><div class="review-heading"><h2>Recent activity</h2><a class="back-link" href="/admin/audit-logs">View audit logs</a></div>{{#each audits}}<div class="admin-activity"><div><strong>{{actionLabel}}</strong><p data-no-translate>{{actor_name}} · {{reference}}</p></div><time data-no-translate>{{timestamp}}</time></div>{{else}}<p class="muted">No admin activity yet.</p>{{/each}}</section>{{/if}}
{{> admin-end}}
