{{> admin-start}}
<a class="back-link" href="/admin/rooms">Back to rooms</a><div class="admin-heading"><h1>Edit room</h1><p data-no-translate>{{room.hotelName}} · {{room.room_number}}</p></div><form data-admin-form data-endpoint="/api/admin/rooms/{{room.room_id}}" class="admin-edit-form"><input name="version" type="hidden" value="{{room.version}}"><div class="admin-form-grid"><div><label for="type">Room type</label><input id="type" name="type" value="{{room.type}}" maxlength="100" required></div><div><label for="capacity">Capacity</label><input id="capacity" name="capacity" type="number" min="1" max="10" value="{{room.capacity}}" required></div><div><label for="price">Nightly rate (PHP)</label><input id="price" name="price" type="number" min="0.01" step="0.01" value="{{room.price}}" required></div><div><label for="published">Publication</label><select id="published" name="published"><option value="1" {{#if room.is_published}}selected{{/if}}>Published</option><option value="0" {{#unless room.is_published}}selected{{/unless}}>Hidden from booking</option></select></div><div class="admin-form-wide"><label for="description">Description</label><textarea id="description" name="description" maxlength="500" required>{{room.description}}</textarea></div></div><p class="field-help mt-5">Rate changes apply to new bookings. Existing booking prices remain unchanged.</p><p role="alert" class="form-error mt-5" tabindex="-1"></p><div class="admin-form-actions"><button class="btn" type="submit">Save changes</button><a class="back-link" href="/admin/rooms">Go back</a></div></form>{{> admin-end}}
