{{> head}}
<body>{{> nav}}<main id="main" class="shell section-space hotel-directory">
<div class="page-intro"><h1>A place for your next chapter.</h1><p>Browse our sample hotels and resorts, then choose the room that suits your plans.</p></div>
<form id="hotelSearch" class="hotel-search" role="search"><div><label for="hotelQuery">Find a hotel or collection</label><input type="search" id="hotelQuery" placeholder="Search by hotel or collection"></div><div><label for="hotelKind">Type of stay</label><select id="hotelKind"><option value="all">All stays</option><option value="Hotel">Hotel</option><option value="Resort">Resort</option></select></div><button class="btn">Search {{> arrow}}</button></form>
<p class="muted mt-5 mb-4">Hotel details and photographs are illustrative.</p><p id="hotelCount" role="status" class="font-semibold"></p>
<div id="hotelResults">{{#each hotels}}<article class="room-listing" data-hotel="{{name}} {{collection}}" data-kind="{{kind}}"><img class="listing-photo" src="{{image}}" alt="Illustrative hotel photography" width="600" height="420" loading="lazy"><div class="listing-info"><div class="listing-features"><span>{{kind}}</span><span>{{collection}}</span></div><h2>{{name}}</h2><p class="listing-description">{{description}}</p><p class="muted mt-4">Deluxe Room · Superior Room · Family Suite</p><div class="listing-bottom mt-6"><span class="muted">Sample property</span><a class="btn" href="/rooms?hotelId={{id}}">View rooms {{> arrow}}</a></div></div></article>{{/each}}</div>
<div id="hotelEmpty" class="empty-state" hidden><h2>No matching stays.</h2><p>Try another hotel name or choose all stays.</p><button id="resetHotels" type="button" class="btn-secondary">Show all stays</button></div>
</main>{{> footer}}<script src="/hotels.js"></script></body></html>
