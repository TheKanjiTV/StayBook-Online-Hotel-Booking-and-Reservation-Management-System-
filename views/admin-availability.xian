{{> admin-start}}
<div class="admin-heading"><h1>Availability</h1><p>Local reservations and dates closed to new online bookings.</p></div><form class="admin-filters" method="get" action="/admin/availability"><div><label for="calendarStart">Starting date</label><input id="calendarStart" name="start" type="date" value="{{start}}" required></div><div><label for="calendarHotel">Hotel or resort</label><select id="calendarHotel" name="hotelId"><option value="">All stays</option>{{#each hotels}}<option value="{{id}}" {{#if selected}}selected{{/if}} data-no-translate>{{name}}</option>{{/each}}</select></div><button class="btn">View calendar</button></form><nav class="admin-pagination" aria-label="Calendar dates"><a class="btn-secondary" href="{{previous}}">Previous</a><a class="btn-secondary" href="{{next}}">Next</a></nav>
<div class="admin-table-scroll admin-section" tabindex="0" role="region" aria-label="Availability calendar"><table class="admin-table availability-calendar"><thead><tr><th scope="col" class="calendar-room">Room</th>{{#each days}}<th scope="col" data-no-translate>{{label}}</th>{{/each}}</tr></thead><tbody>{{#each rooms}}<tr><th scope="row" class="calendar-room">{{type}}<small data-no-translate>{{hotelName}} · {{room_number}}</small></th>{{#each cells}}<td data-date="{{date}}" data-state="{{state}}">{{#if href}}<a href="{{href}}">{{label}}{{#if reference}}<small data-no-translate>{{reference}}</small>{{/if}}</a>{{else}}{{label}}{{/if}}{{#if reason}}<small data-no-translate>{{reason}}</small>{{/if}}</td>{{/each}}</tr>{{/each}}</tbody></table></div>
<section class="admin-section"><h2>Close booking dates</h2><p class="muted mt-3 mb-5">A closure stops new bookings. It cannot overlap an existing reservation.</p><form data-admin-form data-endpoint="/api/admin/closures" class="admin-edit-form"><div class="admin-form-grid"><div class="admin-form-wide"><label for="closureRoom">Room</label><select id="closureRoom" name="roomId" required>{{#each rooms}}<option value="{{room_id}}" data-no-translate>{{hotelName}} · {{room_number}} · {{type}}</option>{{/each}}</select></div><div><label for="closureStart">Closed from</label><input id="closureStart" name="start" type="date" value="{{today}}" min="{{today}}" required></div><div><label for="closureEnd">Available again</label><input id="closureEnd" name="end" type="date" value="{{tomorrow}}" min="{{today}}" required></div><div class="admin-form-wide"><label for="closureReason">Reason</label><input id="closureReason" name="reason" maxlength="200" required></div></div><p role="alert" tabindex="-1" class="form-error mt-5"></p><div class="admin-form-actions"><button class="btn" type="submit">Close dates</button></div></form></section>
<section class="admin-section"><h2>Upcoming closures</h2>{{#each closures}}<div class="admin-activity"><div><strong><span>Room</span> <span data-no-translate>{{roomNumber}}</span></strong><p data-no-translate>{{startLabel}} – {{endLabel}} · {{reason}}</p></div><button class="back-link" data-admin-action data-url="/api/admin/closures/{{closure_id}}/release" data-title="Reopen these dates?" data-description="Remove this closure from the booking calendar." data-label="Reopen dates" data-reference="Room {{roomNumber}} · {{startLabel}} – {{endLabel}} · {{reason}}">Reopen dates</button></div>{{else}}<p class="muted mt-4">No upcoming closures.</p>{{/each}}</section>{{> admin-end}}
