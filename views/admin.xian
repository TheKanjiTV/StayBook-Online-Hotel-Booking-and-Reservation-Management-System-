{{> admin-start}}
<div class="admin-heading"><h1>Bookings</h1><p>Search and manage StayBook reservations.</p></div>
<form action="/admin/bookings" method="get" class="admin-filters" role="search">
<div><label for="bookingSearch">Search bookings</label><input id="bookingSearch" name="q" value="{{q}}" maxlength="100" placeholder="Reference, guest name or email"></div>
<div><label for="bookingStatus">Booking status</label><select id="bookingStatus" name="status"><option value="">All bookings</option><option value="LOCAL_CONFIRMED" {{#if activeSelected}}selected{{/if}}>Awaiting confirmation</option><option value="CANCELLED" {{#if cancelledSelected}}selected{{/if}}>Cancelled</option></select></div>
<button class="btn">Search</button><a class="back-link" href="/admin/bookings">Clear filters</a>
</form>
<p class="admin-results"><span>Reservations</span>: {{count}}</p>
{{#if bookings.length}}
<div class="admin-table-scroll" role="region" aria-label="Reservations" tabindex="0"><table class="admin-table"><thead><tr><th scope="col">Booking reference</th><th scope="col">Guest</th><th scope="col">Room</th><th scope="col">Dates</th><th scope="col">Total (PHP)</th><th scope="col">Booking status</th><th scope="col"><span class="sr-only">Actions</span></th></tr></thead><tbody>
{{#each bookings}}<tr><td data-no-translate>{{reference}}</td><td><span data-no-translate>{{first_name}} {{last_name}}</span><small data-no-translate>{{email}}</small></td><td><span>{{room_type}}</span><small data-no-translate>{{hotelName}} · {{room_number}}</small></td><td><span data-no-translate>{{checkIn}}</span><small data-no-translate>{{checkOut}}</small></td><td class="admin-amount" data-no-translate>{{total}}</td><td>{{#if cancelled}}Cancelled{{else}}Awaiting confirmation{{/if}}</td><td><a class="back-link" href="/admin/bookings/{{reservation_id}}">View booking<span class="sr-only" data-no-translate> {{reference}}</span></a></td></tr>{{/each}}
</tbody></table></div>
{{else}}<div class="admin-empty"><h2>No bookings found</h2><p>Try another search or clear the filters.</p></div>{{/if}}
<nav class="admin-pagination" aria-label="Booking pages">{{#if previous}}<a class="btn-secondary" href="{{previous}}">Previous</a>{{/if}}<p><span>Page</span> {{page}} / {{pages}}</p>{{#if next}}<a class="btn-secondary" href="{{next}}">Next</a>{{/if}}</nav>
{{> admin-end}}
