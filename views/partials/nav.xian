<a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-white focus:p-4">Skip to content</a>
<header class="site-header no-print">
  <div class="preference-bar shell"><details class="preference-menu"><summary><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><path d="M3 12h18"/></svg><span>Language</span> / {{preferences.currency}}</summary><div class="preference-panel"><label for="languageSelect">Language</label><select id="languageSelect" aria-label="Language"><option>English</option></select><label class="mt-4" for="currencySelect">Currency</label><select id="currencySelect" aria-label="Currency"><option>PHP</option></select><p class="field-help">Display currency only. Bookings are recorded in PHP.</p>{{#if preferences.updated}}<p class="field-help"><span>Exchange rates</span>: {{preferences.updated}}</p>{{/if}}<p class="field-help"><a href="https://www.exchangerate-api.com" target="_blank" rel="noreferrer">Rates By Exchange Rate API</a></p><p id="preferenceError" class="form-error" role="alert"></p></div></details></div>
  <div class="shell header-inner">
    <a href="/" class="brand" aria-label="StayBook home">StayBook</a>
    <nav class="nav-links" aria-label="Main navigation">
      <a class="nav-link" href="/">Discover</a><a class="nav-link" href="/rooms">Our rooms</a><a class="nav-link" href="/manage-booking">Find reservations</a><a class="nav-link" href="{{#if account}}/account{{else}}/sign-in{{/if}}">{{#if account}}My StayBook{{else}}Sign in{{/if}}</a><a class="btn nav-book" href="/#booking">Book now {{> arrow}}</a>
    </nav>
    <details class="mobile-nav"><summary>Menu</summary><nav class="mobile-menu" aria-label="Mobile navigation"><a href="/">Discover</a><a href="/rooms">Our rooms</a><a href="/manage-booking">Find reservations</a><a href="{{#if account}}/account{{else}}/sign-in{{/if}}">{{#if account}}My StayBook{{else}}Sign in{{/if}}</a><a href="/#booking">Book now</a></nav></details>
  </div>
</header>
