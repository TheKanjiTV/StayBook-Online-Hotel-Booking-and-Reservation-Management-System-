<a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-white focus:p-4">Skip to content</a>
<header class="site-header no-print"><div class="header-shell header-layout">
<a href="/" class="brand" aria-label="StayBook home">StayBook</a>
<details class="site-menu" open><summary>Menu</summary><nav class="hotel-navigation" aria-label="Main navigation">
<a class="nav-link" href="/hotels">Discover</a><a class="nav-link" href="/rooms">Our rooms</a><a class="nav-link" href="/manage-booking">My booking</a><a class="nav-link" href="/account">My StayBook</a>
</nav></details>
<div class="header-actions"><a class="btn header-book" href="/#booking">Find your stay {{> arrow}}</a></div>
<div class="header-tools">{{> notifications}}{{> language}}{{> currency}}</div>
{{#if account}}<button class="nav-link session-action header-logout" type="button" data-sign-out>Log out</button>{{/if}}
<p id="headerError" class="form-error" role="alert" tabindex="-1"></p>
</div></header>
