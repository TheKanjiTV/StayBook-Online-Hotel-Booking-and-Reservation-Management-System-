</main></div></div><dialog id="adminActionDialog" class="booking-dialog no-print" aria-labelledby="adminActionTitle" aria-describedby="adminActionDescription"><h2 id="adminActionTitle"></h2><p id="adminActionDescription"></p><p id="adminActionReference" data-no-translate></p><p id="adminActionError" role="alert" tabindex="-1" class="form-error"></p><form method="dialog" class="dialog-actions"><button class="btn-secondary" autofocus>Go back</button><button id="adminActionConfirm" class="btn" type="button">Confirm</button></form></dialog><script src="/admin-shell.js"></script><script src="/admin-actions.js"></script><script src="/admin-form.js"></script><script src="/password-toggle.js"></script></body></html>
