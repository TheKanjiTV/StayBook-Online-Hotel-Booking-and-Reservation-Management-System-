{{#if account}}<details class="notification-menu"><summary aria-label="Notifications"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"/></svg><span id="notificationBadge" class="notification-badge" aria-hidden="true" hidden></span></summary><section class="notification-panel" aria-label="Notifications"><div class="review-heading"><h2 class="form-heading">Notifications</h2><button id="readNotifications" class="back-link" type="button">Mark all read</button></div><div id="notificationList" aria-live="polite"><p class="muted">Loading notifications…</p></div><p id="notificationError" class="form-error" role="alert"></p><button id="retryNotifications" class="back-link mt-3" type="button" hidden>Refresh</button></section></details><script defer src="/notifications.js"></script>{{/if}}
