<details class="preference-menu currency-menu"><summary aria-label="Currency"><span dir="ltr" data-no-translate>{{preferences.currency}}</span><svg class="menu-chevron" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m4 6 4 4 4-4"/></svg></summary><div class="preference-panel"><label for="currencySelect">Currency</label><select id="currencySelect" aria-label="Currency"><option>PHP</option></select><p class="field-help">Display currency only. Bookings are recorded in PHP.</p>{{#if preferences.updated}}<p class="field-help"><span>Exchange rates</span>: {{preferences.updated}}</p>{{/if}}<p class="field-help"><a class="underline" href="https://www.exchangerate-api.com" target="_blank" rel="noreferrer">Rates By Exchange Rate API</a></p><p id="currencyError" class="form-error mt-3" role="alert"></p></div></details>
