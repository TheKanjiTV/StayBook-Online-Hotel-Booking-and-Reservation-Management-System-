{{> head }}

<body class="bg-[#F8F7F2] text-gray-800">

  <nav class="bg-white border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-6 py-5 flex justify-between items-center">

      <a href="/" class="text-2xl font-bold text-emerald-900">
        StayBook Online
      </a>

      <div class="flex gap-8 items-center">
        <a href="/" class="text-emerald-800 font-medium">
          Home
        </a>

        <a href="/rooms" class="text-gray-600 hover:text-emerald-800">
          Rooms
        </a>
      </div>

    </div>
  </nav>

  <section class="max-w-7xl mx-auto px-6 py-20">

    <div class="grid lg:grid-cols-2 gap-16 items-center">

      <div>

        <span class="text-emerald-700 font-semibold tracking-widest text-sm">
          WELCOME TO STAYBOOK
        </span>

        <h1 class="text-5xl lg:text-6xl font-serif font-bold mt-6 leading-tight text-emerald-950">
          Your Perfect Stay Starts Here.
        </h1>

        <p class="text-gray-600 text-lg mt-6 leading-relaxed">
          Experience comfort, elegance, and relaxation.
          Discover beautiful rooms designed for your perfect getaway.
        </p>

        <a href="#booking"
           class="inline-block mt-8 bg-emerald-900 text-white px-8 py-4 rounded-xl hover:bg-emerald-800 transition">
          Explore Available Rooms
        </a>

      </div>

      <div>
        <img
          src="https://images.unsplash.com/photo-1566073771259-6a8506099945?w=1200"
          alt="Hotel"
          class="rounded-3xl shadow-xl w-full h-[450px] object-cover"
        >
      </div>

    </div>

  </section>

  <section id="booking" class="max-w-6xl mx-auto px-6 pb-24">

    <div class="bg-white rounded-3xl shadow-xl p-8">

      <div class="mb-8">
        <h2 class="text-2xl font-bold text-emerald-950">
          Find Your Perfect Room
        </h2>

        <p class="text-gray-500 mt-2">
          Select your dates and number of guests.
        </p>
      </div>

      <form
        id="searchForm"
        action="/rooms"
        method="GET"
        class="grid md:grid-cols-4 gap-5 items-end"
      >

        <div>
          <label class="block text-sm font-semibold mb-2">
            Check-in
          </label>

          <input
            type="date"
            id="checkIn"
            name="checkIn"
            required
            class="w-full border border-gray-300 rounded-xl px-4 py-3"
          >
        </div>

        <div>
          <label class="block text-sm font-semibold mb-2">
            Check-out
          </label>

          <input
            type="date"
            id="checkOut"
            name="checkOut"
            required
            class="w-full border border-gray-300 rounded-xl px-4 py-3"
          >
        </div>

        <div>
          <label class="block text-sm font-semibold mb-2">
            Guests
          </label>

          <input
            type="number"
            id="guests"
            name="guests"
            min="1"
            max="10"
            value="2"
            required
            class="w-full border border-gray-300 rounded-xl px-4 py-3"
          >
        </div>

        <button
          type="submit"
          class="bg-emerald-900 text-white py-3.5 rounded-xl font-semibold hover:bg-emerald-800 transition"
        >
          Search Rooms
        </button>

      </form>

      <p id="errorMessage" class="text-red-600 mt-4"></p>

    </div>

  </section>

  <footer class="bg-emerald-950 text-white text-center py-8">
    <p>© 2026 Evergreen Stay. All rights reserved.</p>
  </footer>

  <script>

    const form = document.getElementById("searchForm");

    const checkIn = document.getElementById("checkIn");
    const checkOut = document.getElementById("checkOut");
    const guests = document.getElementById("guests");

    const errorMessage = document.getElementById("errorMessage");

    form.addEventListener("submit", function(event) {

      errorMessage.textContent = "";

      if (checkOut.value <= checkIn.value) {
        event.preventDefault();

        errorMessage.textContent =
          "Check-out must be later than check-in.";

        return;
      }

      if (Number(guests.value) < 1) {
        event.preventDefault();

        errorMessage.textContent =
          "Please enter a valid number of guests.";
      }

    });

  </script>

</body>