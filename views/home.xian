{{> head}}
<body>
{{> nav}}
<main id="main">
  <section class="home-hero">
    <img class="hero-background" src="https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&amp;fit=crop&amp;w=2200&amp;q=90" alt="Sunlit hotel pool beside a timber-roofed resort" width="2200" height="1200" fetchpriority="high">
    <div class="shell hero-content"><div class="hero-copy"><h1>A comfortable stay,<br>simply booked.</h1><p>Choose your dates, find a room and make your reservation. A little less planning. A little more looking forward.</p><a href="#booking" class="text-link">Find your room {{> arrow}}</a></div><p class="hero-photo-note">Illustrative hotel photography</p></div>
  </section>
  <section class="shell home-search">
    <div id="booking" class="booking-bar"><h2>Where does your next stay begin?</h2>
      <form action="/rooms" method="GET" class="search-grid" data-room-search>
        <div class="search-field"><label for="hotelId">Hotel or resort</label><select id="hotelId" name="hotelId"><option value="">All stays</option>{{#each hotels}}<option value="{{id}}">{{name}}</option>{{/each}}</select></div>
        <div class="search-field"><label for="checkIn">Check-in</label><input type="date" id="checkIn" name="checkIn" required></div>
        <div class="search-field"><label for="checkOut">Check-out</label><input type="date" id="checkOut" name="checkOut" required></div>
        <div class="search-field"><label for="guests">Guests</label><select id="guests" name="guests">{{#each guestOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
        <button class="btn">Search rooms {{> arrow}}</button>
      </form><p class="form-error mt-3" data-search-error role="alert"></p>
    </div><p class="demo-caption">Explore our sample room collection. Booking payments are simulated.</p>
  </section>
  <section id="rooms" class="shell section-space"><div class="section-heading"><h2>A room for<br>your kind of stay.</h2><p>From a quiet getaway to a family trip, find the space that feels right for you.</p></div>
    <div class="room-grid">{{#each featuredRooms}}<article class="room-preview"><a href="#booking" aria-label="Find dates for {{type}}"><img src="{{image}}" alt="{{type}} interior, illustrative photograph" width="480" height="360" loading="lazy"></a><div class="room-meta"><span>Up to {{capacity}} guests</span><span>Per room</span></div><h3>{{type}}</h3><p>{{description}}</p><div class="room-price"><span>From </span><strong data-money="{{price}}">₱{{formattedPrice}}</strong><span> / night</span></div><a class="text-link mt-3" href="#booking">Check availability {{> arrow}}</a></article>{{/each}}</div>
  </section>
  <section class="shell booking-note"><div><h3>Already looking forward to your stay?</h3><p class="mt-3">Find your saved booking with its reference and your email address. Review your details or manage a change of plans.</p></div><a class="btn-secondary shrink-0" href="/manage-booking">Find my booking {{> arrow}}</a></section>
</main>
{{> footer}}
<script src="/search.js"></script>
</body></html>
