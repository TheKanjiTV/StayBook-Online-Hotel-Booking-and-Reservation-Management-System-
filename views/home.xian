{{> head}}
<body>
{{> nav}}
<main class="max-w-6xl mx-auto px-5 py-12">
  <section class="grid md:grid-cols-2 gap-10 items-center mb-12">
    <div>
      <p class="text-sm text-emerald-800 font-medium mb-4">WELCOME TO STAYBOOK</p>
      <h1 class="text-4xl md:text-5xl font-serif text-emerald-950 leading-tight">A comfortable stay,<br>simply booked.</h1>
      <p class="mt-5 text-slate-600 max-w-md leading-relaxed">Choose your dates, find a room and make your reservation. Everything you need for your next stay.</p>
      <a href="#booking" class="btn mt-6">Find a room</a>
    </div>
    <img src="https://images.unsplash.com/photo-1566073771259-6a8506099945?w=1000" alt="Hotel and pool" class="rounded-lg w-full h-72 object-cover" width="560" height="288">
  </section>
  <section id="booking" class="panel">
    <h2>Find your room</h2><p class="muted mt-1 mb-5">Browse sample rooms and prepare your online reservation.</p>
    <form action="/rooms" method="GET" class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 items-end">
      <div><label for="checkIn">Check-in</label><input type="date" id="checkIn" name="checkIn" required></div>
      <div><label for="checkOut">Check-out</label><input type="date" id="checkOut" name="checkOut" required></div>
      <div><label for="guests">Guests</label><input type="number" id="guests" name="guests" min="1" max="10" value="2" required></div>
      <button class="btn py-2.5">Search rooms</button>
    </form>
  </section>
  <p class="muted mt-4">Online booking module · sample room catalog · integration with the other systems is planned.</p>
</main>
<script>
const today = new Date().toLocaleDateString('en-CA', {timeZone:'Asia/Manila'});
const ci = document.getElementById('checkIn'), co = document.getElementById('checkOut');
ci.min = today; ci.value = today;
function nextDay(date) { return new Date(Date.parse(date) + 86400000).toISOString().slice(0,10); }
co.min = nextDay(today); co.value = co.min;
ci.addEventListener('change', () => { co.min = nextDay(ci.value); if(co.value <= ci.value) co.value = co.min; });
</script>
</body></html>
