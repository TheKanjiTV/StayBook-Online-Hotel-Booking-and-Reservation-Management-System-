{{> head}}
<body>{{> nav}}
<main id="main" class="shell rooms-page">
  <ol class="booking-steps" aria-label="Booking progress"><li aria-current="step"><span>1</span> Choose your room</li><li><span>2</span> Guest details</li><li><span>3</span> Review booking</li></ol>
  <div class="page-intro"><h1>Find your place to unwind.</h1><p>Choose the room that fits your stay. We’ll take care of the details next.</p></div>
  <section class="rooms-search" aria-label="Change your stay dates"><form action="/rooms" method="GET" class="search-grid" data-room-search>
    <div class="search-field"><label for="hotelId">Hotel or resort</label><select id="hotelId" name="hotelId"><option value="">All stays</option>{{#each hotels}}<option value="{{id}}">{{name}}</option>{{/each}}</select></div>
    <div class="search-field"><label for="checkIn">Check-in</label><input id="checkIn" name="checkIn" type="date" required></div>
    <div class="search-field"><label for="checkOut">Check-out</label><input id="checkOut" name="checkOut" type="date" required></div>
    <div class="search-field"><label for="guests">Guests</label><select id="guests" name="guests">{{#each guestOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
    <button class="btn">Update search {{> arrow}}</button>
  </form><p class="form-error mt-3" data-search-error role="alert"></p></section>
  <section aria-label="Room results"><div class="results-toolbar"><div><p id="resultCount" class="font-semibold">Finding your room…</p><p id="searchSummary" class="muted mt-1"></p></div><div class="sort-control"><label for="sortOrder">Sort by</label><select id="sortOrder"><option value="recommended">Recommended</option><option value="price-low">Price: low to high</option><option value="price-high">Price: high to low</option><option value="capacity">Guest capacity</option></select></div></div>
    <div id="roomFilters" class="room-filters" role="group" aria-label="Filter room types"></div>
    <div id="roomContainer" aria-live="polite" aria-busy="true"><div class="room-loading" role="status"><div class="loading-photo"></div><div><h2>Finding rooms for your stay…</h2><p class="muted mt-3">Checking your selected dates and guest count.</p></div></div></div>
    <p class="demo-caption mb-12">Availability and prices shown are from the local demo catalog. Room photographs are illustrative.</p>
  </section>
</main>{{> footer}}<script src="/search.js"></script><script src="/rooms.js"></script></body></html>
