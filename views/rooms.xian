{{> head }}
<body class="bg-[#F8F7F2] text-gray-800">

  <nav class="bg-white border-b">
    <div class="max-w-7xl mx-auto px-6 py-5 flex justify-between items-center">

      <a href="/" class="text-2xl font-bold text-emerald-900">
        StayBook Online
      </a>

      <a href="/" class="text-gray-600 hover:text-emerald-800">
        Back to Home
      </a>

    </div>
  </nav>

  <main class="max-w-7xl mx-auto px-6 py-14">

    <div class="mb-10">

      <span class="text-emerald-700 font-semibold text-sm tracking-widest">
        YOUR ACCOMMODATION
      </span>

      <h1 class="text-4xl font-serif font-bold text-emerald-950 mt-3">
        Available Rooms
      </h1>

      <p id="searchSummary" class="text-gray-500 mt-3"></p>

    </div>

    <div id="loading" class="text-center py-12 text-gray-500">
      Searching for rooms...
    </div>

    <div
      id="roomContainer"
      class="grid md:grid-cols-2 lg:grid-cols-3 gap-8"
    ></div>

    <div
      id="emptyMessage"
      class="hidden text-center bg-white p-12 rounded-2xl"
    >
      <h2 class="text-xl font-semibold text-gray-700">
        No rooms found
      </h2>

      <p class="text-gray-500 mt-3" id="emptyDescription">
        Try changing your search.
      </p>

      <a href="/" class="inline-block mt-6 text-emerald-800 font-semibold">
        Change Search
      </a>
    </div>

  </main>

  <script>

    const params = new URLSearchParams(window.location.search);

    const checkIn = params.get("checkIn");
    const checkOut = params.get("checkOut");
    const guests = params.get("guests");

    const container = document.getElementById("roomContainer");
    const loading = document.getElementById("loading");
    const emptyMessage = document.getElementById("emptyMessage");

    document.getElementById("searchSummary").textContent =
      `Check-in: ${checkIn || "Not selected"} | Check-out: ${checkOut || "Not selected"} | Guests: ${guests || "Not selected"}`;

    async function loadRooms() {

      try {

        const query = new URLSearchParams({
          checkIn: checkIn || "",
          checkOut: checkOut || "",
          guests: guests || ""
        });

        const response = await fetch(`/rooms/search?${query}`);

        const data = await response.json();

        loading.classList.add("hidden");

        if (!response.ok || !data.success) {
          emptyMessage.classList.remove("hidden");

          document.getElementById("emptyDescription").textContent =
            data.message || "Unable to search rooms.";

          return;
        }

        if (data.rooms.length === 0) {
          emptyMessage.classList.remove("hidden");
          return;
        }

        data.rooms.forEach(function(room) {

          const card = document.createElement("div");

          card.className =
            "bg-white rounded-2xl shadow-sm overflow-hidden border border-gray-100";

          const image = document.createElement("img");
          image.src = room.image;
          image.alt = room.name;
          image.className = "w-full h-56 object-cover";

          const content = document.createElement("div");
          content.className = "p-6";

          const title = document.createElement("h2");
          title.className = "text-2xl font-bold text-emerald-950";
          title.textContent = room.name;

          const description = document.createElement("p");
          description.className = "text-gray-500 mt-3 text-sm";
          description.textContent = room.description;

          const capacity = document.createElement("p");
          capacity.className = "text-gray-600 mt-4 text-sm";
          capacity.textContent = `Up to ${room.capacity} guests`;

          const price = document.createElement("p");
          price.className = "text-2xl font-bold text-emerald-900 mt-5";
          price.textContent =
            `₱${Number(room.price).toLocaleString()} / night`;

          const button = document.createElement("a");

          const bookingParams = new URLSearchParams({
            roomId: room.id,
            checkIn,
            checkOut,
            guests
          });

          button.href = `/guest-details?${bookingParams}`;

          button.className =
            "block text-center mt-6 bg-emerald-900 text-white py-3 rounded-xl hover:bg-emerald-800 transition";

          button.textContent = "Select Room";

          content.appendChild(title);
          content.appendChild(description);
          content.appendChild(capacity);
          content.appendChild(price);
          content.appendChild(button);

          card.appendChild(image);
          card.appendChild(content);

          container.appendChild(card);

        });

      } catch (error) {

        console.error(error);

        loading.classList.add("hidden");
        emptyMessage.classList.remove("hidden");

        document.getElementById("emptyDescription").textContent =
          "Unable to connect to the room search service.";

      }

    }

    loadRooms();

  </script>

</body>